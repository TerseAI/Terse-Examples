# Your environment variables go here.
# Terse credentials are not among them: the platform injects TERSE_PROJECT_KEY into every run.

# Required: the agent calls OpenAI from the actor.
OPENAI_API_KEY=

# Modal runs the sandbox. Leave these commented out to use the credentials in ~/.modal.toml.
# Required when deployed. MODAL_TOKEN_ID and MODAL_TOKEN_SECRET are reserved by the actor runtime.
# SANDBOX_MODAL_TOKEN_ID=
# SANDBOX_MODAL_TOKEN_SECRET=
