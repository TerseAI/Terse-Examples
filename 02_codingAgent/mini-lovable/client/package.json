{
  "name": "durable-actors-mastra-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Elysia + Mastra + Durable Actors WebSocket chat demo",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:backend": "bun --watch src/backend.ts",
    "dev:web": "bun run --cwd web dev",
    "start": "bun src/backend.ts",
    "dev:actors": "durable-actors dev",
    "generate": "durable-actors generate",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@mastra/core": "1.76.0",
    "durable-actors": "0.8.0",
    "elysia": "1.4.30"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "~5.9.3"
  },
  "trustedDependencies": ["esbuild"]
}
